#!/usr/bin/env bash
# tart-snapshot
#
# Clone the base VM into a fresh ephemeral test VM and print its name.
# The caller is responsible for destroying it.
#
# Usage:
#   name=$(./tart-snapshot)         # auto-generated unique name
#   ./tart-snapshot my-vm-name      # explicit name

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/tart-helpers.sh
source "${SCRIPT_DIR}/../lib/tart-helpers.sh"

require_apple_silicon
require_tools

if ! vm_exists "$TART_BASE_VM"; then
  error "Base VM '${TART_BASE_VM}' is missing. Run 'tart-prepare' first."
  exit 1
fi

target="${1:-$(vm_unique_name)}"
if vm_exists "$target"; then
  error "Target VM '${target}' already exists."
  exit 1
fi

step "Cloning '${TART_BASE_VM}' -> '${target}'..." >&2
tart clone "$TART_BASE_VM" "$target" >&2

# Only the name goes to stdout so it can be captured.
echo "$target"
