#!/usr/bin/env bash

trap 'echo Error: $0:$LINENO stopped; exit 1' ERR INT
set -euo pipefail

: "${DOTFILES_GITHUB:=https://github.com/sskmy1024y/dotfiles.git}"
: "${DOTFILES_BRANCH:=master}"
: "${DOTFILES_ASSUME_YES:=}"
: "${TERRAFORM_VERSION:=}"

info() { echo "[+] $*"; }
warn() { echo "[*] $*"; }
error() { echo "[-] $*" >&2; }
is_exists() { command -v "$1" >/dev/null 2>&1; }
git_works() {
  is_exists git || return 1
  if [ "$(detect_os)" = "darwin" ] && is_exists xcode-select; then
    xcode-select -p >/dev/null 2>&1 || return 1
  fi
  git --version >/dev/null 2>&1
}

script_repo_root() {
  local source_dir
  source_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)" || return 1

  if [ -d "${source_dir}/../terraform" ]; then
    cd "${source_dir}/.." >/dev/null 2>&1 && pwd -P
  else
    return 1
  fi
}

if [ -z "${DOTPATH:-}" ]; then
  if DOTPATH="$(script_repo_root 2>/dev/null)"; then
    export DOTPATH
  else
    DOTPATH="$HOME/.dotfiles"; export DOTPATH
  fi
fi

usage() {
  cat <<'USAGE'
Usage: install [options]

Options:
  -y, --yes                  Apply without an interactive confirmation.
      --plan                 Run terraform plan only.
      --check                Check required commands and repository presence only.
      --no-brew              Do not run brew bundle.
      --no-macos-defaults    Do not write macOS defaults.
      --no-1password-ssh     Do not link 1Password SSH config.
  -h, --help                 Show this help.

Environment:
  DOTPATH                    Install path. Default: ~/.dotfiles
  DOTFILES_GITHUB            Git remote. Default: https://github.com/sskmy1024y/dotfiles.git
  DOTFILES_BRANCH            Git branch. Default: master
  DOTFILES_ASSUME_YES=1      Same as --yes.
  TERRAFORM_VERSION          Terraform version for non-Homebrew installs.
USAGE
}

mode="apply"
enable_brew="true"
enable_macos_defaults="true"
enable_1password_ssh="true"
enable_macos_tode="true"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --)
      ;;
    -y | --yes)
      DOTFILES_ASSUME_YES=1
      ;;
    --plan)
      mode="plan"
      ;;
    --check)
      mode="check"
      ;;
    --no-brew)
      enable_brew="false"
      ;;
    --no-macos-defaults)
      enable_macos_defaults="false"
      ;;
    --no-1password-ssh)
      enable_1password_ssh="false"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    init | --init | -i)
      warn "'$1' is deprecated and ignored; the installer always performs the full setup."
      ;;
    *)
      error "Unknown option: $1"
      usage >&2
      exit 2
      ;;
  esac
  shift
done

case "$(uname -s 2>/dev/null || true)" in
  Darwin)
    ;;
  *)
    enable_brew="false"
    enable_macos_defaults="false"
    enable_1password_ssh="false"
    enable_macos_tode="false"
    ;;
esac

detect_os() {
  case "$(uname -s 2>/dev/null || true)" in
    Darwin) echo "darwin" ;;
    Linux) echo "linux" ;;
    *) echo "unknown" ;;
  esac
}

detect_arch() {
  case "$(uname -m 2>/dev/null || true)" in
    arm64 | aarch64) echo "arm64" ;;
    x86_64 | amd64) echo "amd64" ;;
    *) echo "unknown" ;;
  esac
}

brew_on_path() {
  if is_exists brew; then
    return 0
  fi

  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$brew_bin" ]; then
      PATH="$(dirname "$brew_bin"):$PATH"
      export PATH
      return 0
    fi
  done

  return 1
}

ensure_homebrew() {
  if brew_on_path; then
    return 0
  fi

  if [ "$(detect_os)" != "darwin" ]; then
    return 1
  fi

  if [ "$mode" = "check" ]; then
    return 1
  fi

  if ! is_exists curl; then
    error "curl is required to install Homebrew"
    return 1
  fi

  info "Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  brew_on_path
}

confirm_package_install() {
  local command="$1" reply

  if [ -n "$DOTFILES_ASSUME_YES" ] || [ ! -t 0 ]; then
    return 0
  fi

  printf "%s is required. Install it now? [Y/n] " "$command"
  read -r reply
  case "$reply" in
    "" | [Yy] | [Yy][Ee][Ss]) return 0 ;;
    *) return 1 ;;
  esac
}

run_as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif is_exists sudo; then
    sudo "$@"
  else
    error "sudo is required to install packages"
    return 1
  fi
}

install_platform_package() {
  local command="$1" package="$2"

  if ! confirm_package_install "$command"; then
    error "$command installation was declined"
    return 1
  fi

  info "Installing ${command}..."
  if [ "$(detect_os)" = "darwin" ]; then
    ensure_homebrew && brew install "$package"
  elif is_exists apt-get; then
    run_as_root apt-get update && run_as_root apt-get install -y "$package"
  elif is_exists pacman; then
    run_as_root pacman -Sy --noconfirm "$package"
  elif is_exists dnf; then
    run_as_root dnf install -y "$package"
  elif is_exists yum; then
    run_as_root yum install -y "$package"
  elif is_exists apk; then
    run_as_root apk add "$package"
  elif is_exists zypper; then
    run_as_root zypper --non-interactive install "$package"
  else
    error "No supported package manager was found to install ${command}"
    return 1
  fi
}

ensure_git() {
  git_works && return 0
  install_platform_package git git
  git_works
}

ensure_unzip() {
  is_exists unzip && return 0
  install_platform_package unzip unzip
  is_exists unzip
}

ensure_ssh_keygen() {
  local package="openssh-client"
  is_exists ssh-keygen && return 0
  is_exists pacman && package="openssh"
  is_exists apk && package="openssh-keygen"
  install_platform_package ssh-keygen "$package"
  is_exists ssh-keygen
}

ensure_jq() {
  is_exists jq && return 0
  install_platform_package jq jq
  is_exists jq
}

terraform_version() {
  if [ -n "$TERRAFORM_VERSION" ]; then
    echo "$TERRAFORM_VERSION"
    return 0
  fi

  if [ -f "$DOTPATH/terraform/.terraform-version" ]; then
    sed -n '1p' "$DOTPATH/terraform/.terraform-version"
    return 0
  fi

  echo "1.13.1"
}

install_terraform_with_archive() {
  local version os arch url tmp_dir archive
  version="$(terraform_version)"
  os="$(detect_os)"
  arch="$(detect_arch)"

  if [ "$os" = "unknown" ] || [ "$arch" = "unknown" ]; then
    error "unsupported platform for Terraform archive install: $(uname -s 2>/dev/null || true) $(uname -m 2>/dev/null || true)"
    return 1
  fi

  if ! ensure_unzip; then
    error "Failed to install unzip, which is required for Terraform"
    return 1
  fi

  url="https://releases.hashicorp.com/terraform/${version}/terraform_${version}_${os}_${arch}.zip"
  tmp_dir="$(mktemp -d)"
  archive="$tmp_dir/terraform.zip"

  info "Downloading Terraform ${version}..."
  if is_exists curl; then
    curl -fsSL "$url" -o "$archive"
  elif is_exists wget; then
    wget -qO "$archive" "$url"
  else
    error "curl or wget is required to download Terraform"
    return 1
  fi

  unzip -q "$archive" -d "$tmp_dir"
  mkdir -p "$HOME/.local/bin"
  mv "$tmp_dir/terraform" "$HOME/.local/bin/terraform"
  chmod +x "$HOME/.local/bin/terraform"
  PATH="$HOME/.local/bin:$PATH"
  export PATH
  rm -rf "$tmp_dir"
}

install_terraform() {
  if is_exists terraform; then
    return 0
  fi

  if [ "$mode" = "check" ]; then
    return 1
  fi

  info "Terraform is not installed. Installing Terraform..."

  if [ "$(detect_os)" = "darwin" ] && [ "$enable_brew" = "true" ]; then
    if ensure_homebrew && brew install terraform; then
      :
    else
      warn "Homebrew Terraform install failed; falling back to the release archive."
      install_terraform_with_archive
    fi
  else
    if install_terraform_with_archive; then
      :
    elif is_exists brew || brew_on_path; then
      brew install terraform
    else
      return 1
    fi
  fi

  is_exists terraform
}

missing_bootstrap_commands() {
  local missing=0

  if ! is_exists bash; then
    error "bash: command not found"
    missing=1
  fi

  return "$missing"
}

missing_runtime_commands() {
  local missing=0

  if ! is_exists terraform; then
    error "terraform: command not found"
    missing=1
  fi

  if [ "$(detect_os)" = "linux" ] && ! is_exists jq; then
    error "jq: command not found"
    missing=1
  fi

  if [ "$enable_brew" = "true" ] && ! brew_on_path; then
    error "brew: command not found"
    missing=1
  fi

  if [ "$enable_macos_defaults" = "true" ] && ! is_exists defaults; then
    error "defaults: command not found"
    missing=1
  fi

  return "$missing"
}

print_install_hints() {
  cat >&2 <<'HINTS'

Required commands are missing.

macOS example:
  xcode-select --install
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  brew install git terraform

Other platforms:
  Install git and Terraform with your package manager, then rerun this script.
HINTS
}

ensure_requirements() {
  if ! missing_bootstrap_commands; then
    print_install_hints
    exit 1
  fi
}

ensure_runtime_requirements() {
  if [ "$mode" = "check" ]; then
    if ! git_works; then
      error "git: command not found or not functional"
      return 1
    fi
    if ! missing_runtime_commands; then
      print_install_hints
      exit 1
    fi
    return 0
  fi

  if ! ensure_git; then
    error "Failed to install or find a functional Git"
    print_install_hints
    exit 1
  fi

  if [ "$(detect_os)" = "linux" ] && ! ensure_ssh_keygen; then
    error "Failed to install or find ssh-keygen"
    print_install_hints
    exit 1
  fi

  if [ "$(detect_os)" = "linux" ] && ! ensure_jq; then
    error "Failed to install or find jq"
    print_install_hints
    exit 1
  fi

  if ! install_terraform; then
    error "Failed to install Terraform"
    print_install_hints
    exit 1
  fi

  if [ "$enable_brew" = "true" ] && ! ensure_homebrew; then
    error "Failed to install or find Homebrew"
    print_install_hints
    exit 1
  fi

  if [ "$enable_macos_defaults" = "true" ] && ! is_exists defaults; then
    error "defaults: command not found"
    print_install_hints
    exit 1
  fi
}

ensure_repo() {
  if [ -d "$DOTPATH/.git" ]; then
    info "Using existing dotfiles checkout: $DOTPATH"
    return 0
  fi

  if [ -f "$DOTPATH/etc/install" ] && [ -d "$DOTPATH/terraform" ]; then
    info "Using existing dotfiles tree: $DOTPATH"
    return 0
  fi

  if [ -e "$DOTPATH" ]; then
    error "$DOTPATH already exists but is not a git checkout"
    exit 1
  fi

  info "Cloning dotfiles..."
  git clone --branch "$DOTFILES_BRANCH" --single-branch "$DOTFILES_GITHUB" "$DOTPATH"
}

confirm_apply() {
  if [ "$mode" != "apply" ] || [ -n "$DOTFILES_ASSUME_YES" ]; then
    return 0
  fi

  echo ""
  warn "This will run Terraform and may change files under your home directory."
  printf "Continue? [y/N] "
  read -r reply
  case "$reply" in
    [Yy] | [Yy][Ee][Ss])
      ;;
    *)
      error "Aborted."
      exit 1
      ;;
  esac
}

prepare_sudo_for_brew() {
  local sudo_keepalive_pid

  if [ "$(detect_os)" != "darwin" ] || [ "$enable_brew" != "true" ]; then
    return 0
  fi

  if ! is_exists sudo; then
    error "sudo is required to install or upgrade Homebrew casks"
    return 1
  fi

  info "Authenticating administrator access before Homebrew setup..."
  sudo -v -p '[sudo] Password for Homebrew setup: '

  while sudo -n -v 2>/dev/null; do
    sleep 60
  done &
  sudo_keepalive_pid=$!
  trap 'kill '"$sudo_keepalive_pid"' 2>/dev/null || true' EXIT
}

run_terraform() {
  local terraform_dir
  terraform_dir="$DOTPATH/terraform"

  local -a var_args=(
    "-var=enable_brew=${enable_brew}"
    "-var=enable_macos_defaults=${enable_macos_defaults}"
    "-var=enable_1password_ssh=${enable_1password_ssh}"
    "-var=enable_linux_ssh_identity=$([ "$(detect_os)" = "linux" ] && echo true || echo false)"
    "-var=enable_macos_tode=${enable_macos_tode}"
  )

  if [ ! -d "$terraform_dir" ]; then
    error "$terraform_dir: not found"
    exit 1
  fi

  info "Initializing Terraform..."
  terraform -chdir="$terraform_dir" init

  case "$mode" in
    check)
      info "Preflight check completed."
      ;;
    plan)
      info "Planning Terraform changes..."
      terraform -chdir="$terraform_dir" plan "${var_args[@]}"
      ;;
    apply)
      confirm_apply
      prepare_sudo_for_brew
      info "Applying Terraform changes..."
      terraform -chdir="$terraform_dir" apply -auto-approve "${var_args[@]}"
      ;;
  esac
}

main() {
  ensure_requirements
  if [ "$mode" = "check" ]; then
    ensure_runtime_requirements
    if [ -d "$DOTPATH/.git" ]; then
      info "Dotfiles checkout found: $DOTPATH"
    else
      warn "Dotfiles checkout not found: $DOTPATH"
    fi
    info "Preflight check completed."
    exit 0
  fi

  ensure_repo
  ensure_runtime_requirements
  run_terraform
}

main
