#!/usr/bin/env bash

# Author: sskmy1024y
# Last Modified: 24 Aug 2026.
# Install optional language runtimes. OS packages and Homebrew dependencies
# are managed by the Terraform-based `make install` entrypoint.

trap 'echo Error: $0:$LINENO stopped; exit 1' ERR INT
set -euo pipefail

# set dotfiles path as default variable
if [ -z "${DOTPATH:-}" ]; then
    DOTPATH=$HOME/.dotfiles; export DOTPATH
fi

# load lib script (functions)
. "$DOTPATH"/etc/lib/header.sh


info "Installing language runtimes..."

while IFS= read -r script; do
    bash "$script"
done < <(find "$DOTPATH"/etc/scripts/install.d -name "2[0-9]*.sh" | sort)
