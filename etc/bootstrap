#!/usr/bin/env bash

# Author: sskmy1024y
# Description: Remote one-liner entrypoint. Clones the repository if needed,
#              then delegates to etc/install.

trap 'echo Error: $0:$LINENO stopped; exit 1' ERR INT
set -euo pipefail

: "${DOTPATH:=$HOME/.dotfiles}"
: "${DOTFILES_GITHUB:=https://github.com/sskmy1024y/dotfiles.git}"
: "${DOTFILES_BRANCH:=master}"
export DOTPATH DOTFILES_GITHUB DOTFILES_BRANCH

if [ ! -f "$DOTPATH/etc/install" ]; then
  if ! command -v git >/dev/null 2>&1; then
    echo "[-] git: command not found" >&2
    echo "[-] Install git, then rerun this script." >&2
    exit 1
  fi

  if [ -e "$DOTPATH" ]; then
    echo "[-] $DOTPATH exists but $DOTPATH/etc/install is not found" >&2
    exit 1
  fi

  git clone --branch "$DOTFILES_BRANCH" --single-branch "$DOTFILES_GITHUB" "$DOTPATH"
fi

exec bash "$DOTPATH/etc/install" "$@"
