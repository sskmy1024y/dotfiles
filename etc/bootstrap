#!/usr/bin/env bash

# Author: sskmy1024y
# Description: Remote one-liner entrypoint. Downloads the repository if needed,
#              installs the dotfiles CLI, and starts initial setup. Git is
#              intentionally optional for a clean macOS installation.

trap 'echo Error: $0:$LINENO stopped; exit 1' ERR INT
set -euo pipefail

: "${DOTPATH:=$HOME/.dotfiles}"
: "${DOTFILES_GITHUB:=https://github.com/sskmy1024y/dotfiles.git}"
: "${DOTFILES_BRANCH:=master}"

# Normalize an SSH-form remote (git@host:owner/repo or ssh://git@host/owner/repo)
# to https:// so the archive download URL below is always a valid https URL.
normalize_git_https() {
  case "$1" in
    git@*:*)
      local rest="${1#git@}"
      echo "https://${rest%%:*}/${rest#*:}"
      ;;
    ssh://git@*)
      echo "https://${1#ssh://git@}"
      ;;
    *)
      echo "$1"
      ;;
  esac
}

: "${DOTFILES_ARCHIVE_URL:=$(normalize_git_https "${DOTFILES_GITHUB%.git}")/archive/refs/heads/${DOTFILES_BRANCH}.tar.gz}"
export DOTPATH DOTFILES_GITHUB DOTFILES_BRANCH

git_works() {
  command -v git >/dev/null 2>&1 || return 1
  if [ "$(uname -s 2>/dev/null || true)" = "Darwin" ] && command -v xcode-select >/dev/null 2>&1; then
    xcode-select -p >/dev/null 2>&1 || return 1
  fi
  git --version >/dev/null 2>&1
}

if [ ! -f "$DOTPATH/etc/install" ]; then
  if [ -e "$DOTPATH" ]; then
    echo "[-] $DOTPATH exists but $DOTPATH/etc/install is not found" >&2
    exit 1
  fi

  if git_works; then
    git clone --branch "$DOTFILES_BRANCH" --single-branch "$DOTFILES_GITHUB" "$DOTPATH"
  else
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT
    archive="$tmp_dir/dotfiles.tar.gz"

    echo "[*] Git is not available; downloading the dotfiles tarball instead."
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "$DOTFILES_ARCHIVE_URL" -o "$archive"
    elif command -v wget >/dev/null 2>&1; then
      wget -qO "$archive" "$DOTFILES_ARCHIVE_URL"
    else
      echo "[-] curl or wget is required to download dotfiles" >&2
      exit 1
    fi

    if ! command -v tar >/dev/null 2>&1; then
      echo "[-] tar is required to extract dotfiles" >&2
      exit 1
    fi

    mkdir -p "$DOTPATH"
    tar -xzf "$archive" -C "$DOTPATH" --strip-components=1
    rm -rf "$tmp_dir"
    trap - EXIT
  fi
fi

cli="$DOTPATH/bin/dotfiles"

if [ ! -f "$cli" ]; then
  # Compatibility with archive fixtures and checkouts created before the CLI.
  exec bash "$DOTPATH/etc/install" "$@"
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "$cli" "$HOME/.local/bin/dotfiles"

if [ "$#" -gt 0 ]; then
  case "$1" in
    -*) exec bash "$cli" install "$@" ;;
    *) exec bash "$cli" "$@" ;;
  esac
fi

if bash "$cli" __is_initialized; then
  exec bash "$cli"
fi

exec bash "$cli" install
